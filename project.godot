; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Micro Farm Manager"
config/description="A retro pixel art idle farming game with robot helpers"
config/version="1.0.4"
config/version_code=5
run/main_scene="res://scenes/main_game.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icons/app_icon.png"

[editor_plugins]

enabled=PackedStringArray("res://addons/UpdateInstaller/plugin.cfg")

[display]

window/size/viewport_width=480
window/size/viewport_height=854
window/size/window_width_override=480
window/size/window_height_override=854
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

